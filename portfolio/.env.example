# ───────────── Required ─────────────
# PostgreSQL connection string. Locally: postgres://postgres@localhost:5432/portfolio
DATABASE_URL=postgres://postgres:postgres@localhost:5432/portfolio

# Random secret used to hash IP addresses for rate limiting. Generate with: openssl rand -hex 32
APP_SECRET=replace-with-a-long-random-string

# ───────────── First admin account ─────────────
# On start-up, an admin with this email is created if it doesn't exist (password: 12+ characters).
# Remove ADMIN_PASSWORD after your first login. Existing passwords are never overwritten unless
# ADMIN_RESET_PASSWORD=true (account recovery; set it back to false afterwards).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_RESET_PASSWORD=false

# ───────────── Media storage ─────────────
# database (default; files stored in Postgres, persistent, no extra service)
# s3       (AWS S3 / Cloudflare R2 / Backblaze B2 / MinIO, recommended if the library grows large)
# local    (development only, files in ./.data/uploads)
STORAGE_DRIVER=database
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional public base URL (e.g. https://media.example.com). If empty, files are served via /media/…
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

# ───────────── Contact form email (optional) ─────────────
# Messages are always saved to the admin inbox. With a Resend API key they are also emailed.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be an address on a domain verified in Resend, e.g. "Portfolio <hello@yourdomain.com>"
CONTACT_FROM_EMAIL=

# ───────────── Site ─────────────
# Public URL used for canonical links, sitemap and social previews (no trailing slash).
# Can also be set in Admin → Site settings → SEO.
SITE_URL=http://localhost:3000

# ───────────── Advanced ─────────────
# PGSSL=disable | no-verify | verify (automatic by default)
PGSSL=
# Set to true to skip the content seed on start-up
SKIP_SEED=false
NEXT_TELEMETRY_DISABLED=1
