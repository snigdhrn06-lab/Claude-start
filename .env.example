# All optional. Consult Brain runs fully without any of these.
PORT=8787
# Enables AI-phrased stakeholder dialogue and AI-assisted rubric grading in the boardroom.
# Without it, the deterministic engine handles both.
ANTHROPIC_API_KEY=
# Model used when a key is present (default: claude-opus-5-5)
CB_MODEL=
# Set to 1 to force deterministic mode even when a key is present
CB_DISABLE_AI=
# Where the local database file lives (default: ./data)
CB_DATA_DIR=
